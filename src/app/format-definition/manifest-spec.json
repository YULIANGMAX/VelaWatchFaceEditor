{
  "$schema": "./manifest-spec.schema.json",
  "schemaVersion": 1,
  "format": "vela-manifest-observed-p65-v1",
  "structure": {
    "root": {
      "tag": "Watchface",
      "fields": [
        {
          "key": "id",
          "type": "string",
          "required": true,
          "pattern": "^\\d{9}(?:\\d{3})?$",
          "patternErrorCode": "invalid-watchface-id",
          "patternErrorMessage": "表盘 ID 必须为 9 位或 12 位数字"
        },
        {
          "key": "name",
          "type": "textOrReference",
          "required": true,
          "referenceTypes": [
            "Translation"
          ]
        },
        {
          "key": "width",
          "type": "number",
          "minimum": 1
        },
        {
          "key": "height",
          "type": "number",
          "minimum": 1
        },
        {
          "key": "SKU",
          "type": "boolean"
        },
        {
          "key": "compressMethod",
          "type": "string",
          "enum": [
            "RLEReversed",
            "None"
          ]
        },
        {
          "key": "advanced",
          "type": "boolean"
        },
        {
          "key": "interactive",
          "type": "boolean"
        },
        {
          "key": "powerConsumptionLevel",
          "type": "number",
          "enum": [
            "1",
            "2",
            "3",
            "4",
            "5"
          ]
        },
        {
          "key": "support_literal",
          "type": "boolean"
        },
        {
          "key": "editable",
          "type": "boolean"
        },
        {
          "key": "recolorTable",
          "type": "string"
        },
        {
          "key": "colorGroupTable",
          "type": "string"
        }
      ],
      "children": [
        {
          "tag": "Resources",
          "minimum": 1,
          "maximum": 1
        },
        {
          "tag": "Theme",
          "minimum": 1
        }
      ]
    },
    "resources": {
      "tag": "Resources",
      "resourceTypes": [
        "Image",
        "ImageArray",
        "Sprite",
        "File",
        "Translation",
        "DataItemText",
        "DataItemImageNumber",
        "DataItemImageValues",
        "DataItemPointer",
        "DataItemArcProgressBar",
        "DataItemLineProgressBar",
        "Slot",
        "Widget"
      ]
    },
    "theme": {
      "tag": "Theme",
      "fields": [
        {
          "key": "type",
          "type": "string",
          "required": true,
          "enum": [
            "normal",
            "AOD"
