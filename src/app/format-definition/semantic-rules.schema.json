{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.miwatchfaceeditor/semantic-rules.schema.json",
  "title": "manifest.xml 声明式语义规则",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "values"],
      "properties": {
        "attribute": { "type": "string", "minLength": 1 },
        "values": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "negate": { "type": "boolean" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "target", "code", "severity", "message"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["mutuallyExclusiveAttributes", "anyAttribute", "anyAttributeOrChildAttribute", "attributeLessThan", "childCount", "uniqueChildAttribute"]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": { "enum": ["root", "resource"] },
            "resourceTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "attributes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "attribute": { "type": "string", "minLength": 1 },
        "childAttribute": { "type": "string", "minLength": 1 },
        "left": { "type": "string", "minLength": 1 },
        "right": { "type": "string", "minLength": 1 },
        "minimum": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 0 },
        "when": { "$ref": "#/$defs/condition" },
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
