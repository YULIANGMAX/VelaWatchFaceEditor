{
  "name": "vela-watchface-editor",
  "private": true,
  "version": "0.2.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "predev": "npm run version:sync",
    "dev": "vite",
    "prebuild": "npm run version:sync",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run version:sync",
    "typecheck": "tsc -b --pretty false",
    "pretest": "npm run version:sync",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:icon": "node scripts/sync-icon.mjs",
    "pretauri:dev": "npm run tauri:icon && npm run version:sync",
    "pretauri:build": "npm run tauri:icon && npm run version:sync",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource/noto-sans": "^5.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "image-q": "^4.0.0",
    "lucide-react": "^1.31.0",
    "misans": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
